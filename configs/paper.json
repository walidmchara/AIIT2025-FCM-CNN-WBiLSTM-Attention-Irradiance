{
  "doi": "10.1109/AIIT63112.2025.11082921",
  "dataset": "PVGIS, 2005-01-01 through 2020-12-31, Riyadh/Medina/Mecca/Dammam",
  "variables": ["GI", "SE", "AT", "H", "WV"],
  "target": "GI",
  "n_clusters": 3,
  "fcm_tolerance": 0.0001,
  "fcm_max_iter": 2000,
  "cnn_filters": [64, 128, 256],
  "cnn_kernel_sizes": [5, 5, 5],
  "cnn_pool_sizes": [3, 3, 3],
  "dropout": 0.4,
  "lstm_units": 150,
  "attention_units": 300,
  "morlet_frequency": 1.75,
  "loss": "mae",
  "optimizer": "adam",
  "train_fraction": 0.8,
  "val_share_train": 0.15,
  "lookback": 96,
  "batch_size": 32,
  "epochs": 40,
  "learning_rate": 0.001,
  "seed": 42,
  "mape_floor_W_m2": 10.0,
  "assumptions": ["FCM number of clusters = 3; verify against full published setup", "lookback=96, validation slice, epochs, batch size, learning rate and MAPE floor are explicit evaluation choices, not claimed as published hyperparameters"]
}
